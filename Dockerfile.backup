# Sidecar service: periodically archives the wiki volume (database + uploads)
# to a timestamped, rotating set of zip files under /backups.
FROM alpine:3.20

RUN apk add --no-cache sqlite bash tzdata

ENV BACKUP_INTERVAL=86400 \
    BACKUP_KEEP=14 \
    BACKUP_DIR=/backups \
    WIKI_DB_PATH=/app/data/wiki.db \
    TZ=UTC

COPY backup.sh /usr/local/bin/backup.sh
RUN chmod +x /usr/local/bin/backup.sh && \
    mkdir -p /backups && \
    echo "Backup dir: ${BACKUP_DIR}"

VOLUME ["/backups"]

CMD ["/usr/local/bin/backup.sh"]
