# Family Wiki backup configuration
# Copy this file to .env and adjust. docker compose loads .env automatically.

# How often to run a backup (seconds). Default: 86400 = daily
BACKUP_INTERVAL=86400

# How many of each backup type to keep before pruning old ones
BACKUP_KEEP=14

# Where backups are written (on the machine running docker).
# Default: the "backups" folder next to the project. For your NAS, just point
# this at the mounted share, e.g. /mnt/nas/wiki-backups
# A trailing /backups path is created if it does not exist.
BACKUP_DIR=./backups
