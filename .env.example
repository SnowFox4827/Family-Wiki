# ==========================================
# Family Wiki - Environment Configuration
# Copy this file to .env and adjust values
# ==========================================

# Port exposed on your host machine / browser (e.g. 5005)
WIKI_PORT=5005

# Local database storage path on host
DATA_DIR=./data

# Backup destination path on host
# Local default: ./backups
# OpenMediaVault (OMV) / NAS example: /srv/dev-disk-by-uuid-XXXX-XXXX/Backups/FamilyWiki
BACKUP_HOST_DIR=./backups

# Automated backup interval in hours (e.g. 24 = once daily)
BACKUP_INTERVAL_HOURS=24

# Number of days to keep backup snapshots before automatic deletion
RETENTION_DAYS=30
