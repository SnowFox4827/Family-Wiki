# Family Wiki backup configuration
# Copy to .env and adjust. docker compose loads .env automatically.

# How often to run a backup (seconds). Default: 86400 = daily
BACKUP_INTERVAL=86400

# How many of each backup type to keep before pruning old ones
BACKUP_KEEP=14

# Where backups are written.
# - Default: a docker volume named "wiki-backups"
# - For a NAS: mount it and set this to the mount path, e.g. /mnt/nas/wiki-backups
BACKUP_DIR=/backups
